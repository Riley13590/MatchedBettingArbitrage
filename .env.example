# Copy to .env and fill in. Never commit the populated file.

# --- App ---
APP_ENV=development
APP_MODE=PAPER
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://marketedge:marketedge@postgres:5432/marketedge
REDIS_URL=redis://redis:6379/0

# --- Betfair Exchange API ---
# https://developer.betfair.com — certificate login (non-interactive) requires
# an application key plus a client SSL certificate registered with Betfair.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=
BETFAIR_KEY_PATH=
BETFAIR_IDENTITY_URL=https://identitysso-cert.betfair.com/api/certlogin
BETFAIR_API_URL=https://api.betfair.com/exchange/betting/json-rpc/v1
BETFAIR_STREAM_HOST=stream-api.betfair.com
BETFAIR_STREAM_PORT=443
BETFAIR_EXECUTION_ALLOWED=false

# --- Secondary exchanges (Milestone 9, not used yet) ---
SMARKETS_SESSION_TOKEN=
MATCHBOOK_USERNAME=
MATCHBOOK_PASSWORD=

# --- Bookmaker odds provider (Milestone 2 — The Odds API, api.the-odds-api.com) ---
# Free tier is enough to validate ingestion/matching (spec section 41.1
# "development vs economic validation"); a paid tier is a later, deliberate
# decision, not something this codebase assumes or hard-codes.
ODDS_PROVIDER_API_KEY=
ODDS_PROVIDER_BASE_URL=https://api.the-odds-api.com/v4
ODDS_PROVIDER_REGIONS=uk
ODDS_PROVIDER_MARKETS=h2h

# --- API-credit budget (spec section 41.2/41.6) ---
ODDS_PROVIDER_SOFT_MONTHLY_BUDGET=18000
ODDS_PROVIDER_HARD_MONTHLY_BUDGET=20000

# --- Adaptive discovery polling, seconds (spec section 41.3 defaults) ---
DISCOVERY_POLL_SECONDS_GT_24H=1800
DISCOVERY_POLL_SECONDS_6H_24H=600
DISCOVERY_POLL_SECONDS_1H_6H=180
DISCOVERY_POLL_SECONDS_LT_1H=60

# --- Arbitrage detector (Milestone 3) — detection + paper persistence only,
# no execution capability exists yet. Safe to leave enabled. ---
ARBITRAGE_ENABLED=true
ARBITRAGE_MIN_NET_ROI=0.008
ARBITRAGE_MIN_PROFIT_GBP=2.00
ARBITRAGE_MAX_QUOTE_AGE_MS=2000
ARBITRAGE_MIN_SECONDS_TO_START=300
ARBITRAGE_IN_PLAY=false
ARBITRAGE_DEFAULT_BANKROLL_GBP=1000
